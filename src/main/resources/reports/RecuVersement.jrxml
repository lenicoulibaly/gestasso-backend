	<subDataset name="DetailsVersement" uuid="2abef68d-f860-4f80-b5a8-7224b0e73dd5">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="gestasso_data_source"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="277"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="718"/>
		<parameter name="DETAILS_VERSEMENT_ID" class="java.lang.Long"/>
		<queryString language="SQL">
			<![CDATA[select subquery.montant, subquery.montant_lettre, subquery.echeance_id, subquery.nom_echeance, subquery.retard_echeance
     , trunc(subquery.reste_echeance) as reste_echeance, (case when subquery.retard_echeance then 'Retard' when subquery.reste_echeance = 0 then 'Soldé' else 'En cours de paiement' end) as statut
from
    (select trunc(p.montant) montant, p.montant_lettre  , p.echeance_id, e.nom_echeance,
            (select vpc.retard_echeance from v_paiement_cotisation vpc where vpc.echeance_id = e.echeance_id and vpc.adhesion_id = v.adhesion_id) as retard_echeance,
           (select vpc.reste_echeance from v_paiement_cotisation vpc where vpc.echeance_id = e.echeance_id and vpc.adhesion_id = v.adhesion_id) as reste_echeance

    from paiement p
        join echeance e on p.echeance_id = e.echeance_id
        join versement v on p.versement_id = v.versement_id
    where p.versement_id = $P{DETAILS_VERSEMENT_ID}) as subquery]]>
		</queryString>
		<field name="montant" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.label" value="montant"/>
		</field>
		<field name="montant_lettre" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.label" value="montant_lettre"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="paiement"/>
		</field>
		<field name="echeance_id" class="java.lang.Long">
			<property name="com.jaspersoft.studio.field.label" value="echeance_id"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="paiement"/>
		</field>
		<field name="nom_echeance" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.label" value="nom_echeance"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="echeance"/>
		</field>
		<field name="retard_echeance" class="java.lang.Boolean">
			<property name="com.jaspersoft.studio.field.label" value="retard_echeance"/>
		</field>
		<field name="reste_echeance" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.label" value="reste_echeance"/>
		</field>
		<field name="statut" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.label" value="statut"/>
		</field>
	</subDataset>
	<parameter name="VERSEMENT_ID" class="java.lang.Long"/>
	<parameter name="LOGO" class="java.io.InputStream"/>
	<parameter name="QR_CODE" class="java.io.ByteArrayInputStream"/>
	<queryString language="SQL">
		<![CDATA[select u.first_name, u.last_name, u.email, u.matricule_fonctionnaire, u.tel
     , asso.asso_name, coalesce(asso.sigle, '') as asso_sigle, asso.situation_geo, v.versement_id, v.code_versement
     , c.nom_cotisation, c.motif
     , v.montant, v.montant_lettre, v.date_versement
     , t.unique_code, t.name,
    (SELECT STRING_AGG(e.nom_echeance, ', ' ORDER BY e.date_echeance)
     FROM paiement p
              JOIN echeance e ON p.echeance_id = e.echeance_id
     WHERE p.versement_id = v.versement_id
       AND p.active) as periodes
from versement v
         join adhesion a on v.adhesion_id = a.adhesion_id
         join app_user u on a.member_id = u.user_id
         join cotisation c on v.cotisation_id = c.cotisation_id
         join association asso on a.asso_id = asso.asso_id
         join type t on v.mode_paiement_unique_code = t.unique_code
where v.versement_id=$P{VERSEMENT_ID}]]>
	</queryString>
